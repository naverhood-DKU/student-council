# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
# - docker compose 는 .env 를 자동으로 읽는다.
# - 앱은 local 프로필일 때만 .env 를 읽는다. 셸 환경변수가 있으면 그쪽이 먼저다.
# - 값을 비워 둘 줄은 지우거나 # 으로 막는다. "KEY=" 처럼 빈 값을 두면 기본값 대신 빈 값이 들어간다.
# - 운영(prod)은 .env 를 읽지 않는다. 서버 환경변수로 넣는다.

# ── docker compose(로컬 MySQL) ──
MYSQL_USER=councilflow
MYSQL_PASSWORD=councilflow
MYSQL_ROOT_PASSWORD=councilflow-root
# 내 PC의 3306을 다른 DB가 쓰고 있으면 바꾼다(그럼 DB_URL 포트도 같이).
MYSQL_PORT=3306

# ── 앱 ──
DB_URL=jdbc:mysql://localhost:3306/councilflow
DB_USERNAME=councilflow
DB_PASSWORD=councilflow
# 32바이트 이상 임의 문자열. 예: openssl rand -base64 48 (local 은 막아 두면 개발용 기본값)
# JWT_SECRET=

# CLOVA Studio > API 키 (Bearer 뒤에 붙는 값). 없으면 분석이 AI_KEY_MISSING 으로 실패한다.
# 키 없이 화면만 확인하려면 fake-ai 프로필을 쓴다.
# CLOVA_STUDIO_API_KEY=

# 녹음 전사. 막아 두면 데모 전사("(데모 전사)" 고정 문장). 실제 녹음 내용으로 전사하려면 clova.
# SPEECH_MODE=clova
# CLOVA Speech 도메인 빌더 > 설정 > 연동 정보. Invoke URL(https://로 시작)과 Secret Key 를 서로 바꿔 넣지 않게 주의.
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET_KEY=
# 로컬에서 올린 녹음을 저장할 폴더(막아 두면 시스템 임시 폴더 아래 council-flow-recordings)
# LOCAL_STORAGE_DIR=

# ── local 프로필 시드 계정 비밀번호 (막아 두면 1234) ──
# SEED_PASSWORD=
